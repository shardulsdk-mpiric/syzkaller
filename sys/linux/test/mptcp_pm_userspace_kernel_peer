# A userspace-PM server announcing to an in-kernel-PM client, the usual real-world
# split (a server daemon, a client host on defaults). The client accepts the
# announcements (add_addr_accepted 2) and opens subflows to them: to the plain
# address through the wildcard listener, and to the announced port through the
# listener the announce call opens. Then the server withdraws both and its id 0.

syz_mptcp_pm_set_limits(0x2, 0x2, 0x0, 0x0)
r0 = syz_mptcp_pair_init$client_kernel(&AUTO={0x2, 0x0, @loopback}, &AUTO={0x2, 0x0, @loopback}, 0x10, 0x1, 0x0, &AUTO=<r1=>0x0)
r2 = syz_mptcp_pm_announce$server(r1, 0x1, 0x0, 0x0)
r3 = syz_mptcp_pm_announce$server_port(r1, 0x1, 0x1, 0x1)
syz_mptcp_drive_traffic(r0, &AUTO="4142434445464748", 0x8)
syz_mptcp_pm_remove$announced(r2, 0x0)
syz_mptcp_pm_remove$announced(r3, 0x0)
syz_mptcp_pm_remove$id0_server(r1, 0x3)
syz_mptcp_pair_close(r0)
