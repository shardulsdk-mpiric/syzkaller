# Stall one subflow of a two-subflow pair while data is pushed both ways, in each
# mode: delay the joined subflow's packets both ways (20ms, 300ms), hold the
# initial subflow's ACKs (100ms), drop the joined subflow's data (100ms). Each
# stall releases what it held before returning, so the pair still carries data
# afterwards and tears down normally.

r0 = syz_mptcp_pair_init(&AUTO={0x2, 0x0, @loopback}, &AUTO={0x2, 0x0, @loopback}, 0x0, 0x0, &AUTO=<r10=>0x0, &AUTO)
r1 = syz_mptcp_join_subflow(r10, 0x1, 0x0, 0x0)
syz_mptcp_subflow_stall(r1, 0x0, 0x0, 0x3, 0x14, 0x12c, &AUTO="", 0x400)
syz_mptcp_subflow_stall(r1, 0x1, 0x1, 0x2, 0x1, 0x64, &AUTO="", 0x400)
syz_mptcp_subflow_stall(r1, 0x0, 0x2, 0x1, 0x1, 0x64, &AUTO="", 0x400)
syz_mptcp_drive_traffic(r0, &AUTO="4142434445464748", 0x8)
syz_mptcp_subflow_destroy(r1)
syz_mptcp_pair_close(r0)
